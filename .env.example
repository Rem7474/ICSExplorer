# ==========================================
# ICSExplorer Environment Variables
# ==========================================

# Port d'écoute du serveur HTTP (défaut: 8080)
PORT=8080

# Identifiants Agalan (Grenoble INP) pour la synchronisation ADE
AGALAN_LOGIN=votre_identifiant_agalan
AGALAN_PASSWORD=votre_mot_de_passe_agalan

# Fréquence de synchronisation automatique (ex: 15m, 30m, 1h, 2h)
SYNC_INTERVAL=30m

# Synchroniser automatiquement au démarrage du serveur (true/false)
SYNC_ON_STARTUP=true

# Télécharger et fusionner l'agenda Google Calendar du Cercle Esisar (true/false)
SYNC_CERCLE=true

# Concurrence du Worker Pool (nombre de téléchargements simultanés)
CONCURRENCY=5

# Surveillance de fraîcheur des données (seuil max avant alerte 503 sur /api/health)
MAX_DATA_AGE=24h
MIN_FILE_SIZE_BYTES=50000

# Format des logs (text ou json) et niveau (debug, info, warn, error)
LOG_LEVEL=info
LOG_FORMAT=text

# Jeton secret optionnel pour sécuriser le déclenchement manuel POST /api/sync
ADMIN_TOKEN=
