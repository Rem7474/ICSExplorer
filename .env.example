# ==========================================
# ICSExplorer Environment Variables
# ==========================================

# Port d'écoute du serveur HTTP (défaut: 8080)
PORT=8080

# Identifiants Agalan (Grenoble INP) pour la synchronisation ADE
AGALAN_LOGIN=votre_identifiant_agalan
AGALAN_PASSWORD=votre_mot_de_passe_agalan

# Fréquence de synchronisation automatique (ex: 15m, 30m, 1h, 2h)
SYNC_INTERVAL=30m

# Synchroniser automatiquement au démarrage du serveur (true/false)
SYNC_ON_STARTUP=true

# Télécharger et fusionner l'agenda Google Calendar du Cercle Esisar (true/false)
SYNC_CERCLE=true

# Télécharger les menus du restaurant universitaire (RU Briff'O) via CROUStillant Open Data
SYNC_RU=true
RU_RESTAURANT_ID=1459
RU_SLOT_START=12:00
RU_SLOT_END=13:00

# Concurrence du Worker Pool (nombre de téléchargements simultanés)
CONCURRENCY=5

# Surveillance de fraîcheur des données (seuil max avant alerte 503 sur /api/health)
MAX_DATA_AGE=24h
MIN_FILE_SIZE_BYTES=50000

# Format des logs (text ou json) et niveau (debug, info, warn, error)
LOG_LEVEL=info
LOG_FORMAT=text

# Jeton secret requis pour déclencher manuellement POST /api/sync
# (vide = synchronisation manuelle désactivée ; la synchro planifiée reste active)
# Générer avec : openssl rand -hex 32
ADMIN_TOKEN=

# Reverse proxies de confiance (IP ou CIDR, séparés par des virgules).
# Seuls ces proxies peuvent fournir X-Forwarded-For / X-Forwarded-Proto
# (limitation de débit par IP réelle du client, en-tête HSTS derrière HTTPS).
# Exemple Docker/Traefik : TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# Clé de licence PrimeUI optionnelle (injectée dynamiquement par Go au runtime ou par Vite au build)
PRIMEUI_LICENSE=
VITE_PRIMEUI_LICENSE=
